# WSL worker profile. This file is documentation, not loaded automatically.
CONTROL_URL=http://127.0.0.1:8787/
WORKER_TOKEN=use-generated-local-token-or-separate-production-worker-secret
# Optional provider affinity; omit to handle both. Repeat the same worker with another profile.
WORKER_PROVIDER=codex-luna
POLL_INTERVAL_MS=30000
CODEX_BIN=/absolute/path/to/codex
PI_BIN=/absolute/path/to/pi
PI_DEVIN_EXTENSION=/absolute/path/to/pi-devin-connector/extensions/index.ts
# Real CLI auth remains in its existing local store. Do not copy credentials here.
# No OPENAI_API_KEY, DEVIN_API_KEY, or generic HTTP endpoint is accepted by the adapter.
