# WSL worker profile. This file is documentation, not loaded automatically.
CONTROL_URL=http://127.0.0.1:8787/
WORKER_TOKEN=use-generated-local-token-or-separate-production-worker-secret
# Optional provider affinity; omit to handle both. Repeat the same worker with another profile.
WORKER_PROVIDER=codex-luna
POLL_INTERVAL_MS=30000
CODEX_BIN=/absolute/path/to/codex
PI_BIN=/absolute/path/to/pi
PI_DEVIN_EXTENSION=/absolute/path/to/pi-devin-connector/extensions/index.ts
# Real CLI auth remains in its existing local store. Do not copy credentials here.
# No OPENAI_API_KEY, DEVIN_API_KEY, or generic HTTP endpoint is accepted by the adapter.

# Development runner: administrator-only paths, never accepted from a submitted task.
DEVELOPMENT_REPOSITORY=/absolute/path/to/private-agent
DEVELOPMENT_WORKTREES=/absolute/path/to/dedicated-task-worktrees
CODEX_PACKAGE=/absolute/path/to/node_modules/@openai/codex
CODEX_AUTH_FILE=/absolute/path/to/existing/.codex/auth.json
DEVELOPMENT_PUBLISH_AUTHORIZED=false
# MCP uses an owner-scoped viewer token through its process environment.
VIEWER_TOKEN=use-separate-local-viewer-token
## Optional TAKT adapter, installed in its own locked npm prefix.
# TAKT_RUNTIME=/absolute/private-agent/runtime/takt
# TAKT_INPUTS=/absolute/private-agent/examples/takt
# TAKT_RUNS=/absolute/private-agent/.local/takt-runs
# Add codex-sol capacity explicitly; Sol/Luna share the same ChatGPT auth group.
